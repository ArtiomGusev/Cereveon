# =============================================================================
# .env.prod.example — Production server environment template
# =============================================================================
# Copy to .env.prod on your Hetzner server and fill in every CHANGE_ME value.
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# Variables managed by Docker Compose or shell (not this file):
#   REDIS_URL         — set in docker-compose.prod.yml environment: block
#   DOMAIN            — exported in the shell before running compose
#   GHCR_IMAGE        — exported in the shell / set by CI via DEPLOY_IMAGE
# =============================================================================

# ── Runtime mode (required) ──────────────────────────────────────────────────
SECA_ENV=prod

# ── API authentication (required) ────────────────────────────────────────────
# Generate: openssl rand -hex 32
SECA_API_KEY=CHANGE_ME

# ── Session / JWT secret (required, >= 32 chars) ─────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME

# ── CORS (required) ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
CORS_ALLOWED_ORIGINS=https://cereveon.com

# ── Database (required) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://chesscoach:CHANGE_ME@db:5432/chesscoach
POSTGRES_DB=chesscoach
POSTGRES_USER=chesscoach
POSTGRES_PASSWORD=CHANGE_ME

# ── LLM / DeepSeek (required for coaching) ───────────────────────────────────
# Sign up at https://platform.deepseek.com, create an API key, paste here.
# Without it, every /chat call falls back to the deterministic template
# (chat_pipeline.py:557 catches LLMConfigError and degrades gracefully).
COACH_DEEPSEEK_API_KEY=CHANGE_ME

# Override only if you point at a self-hosted OpenAI-compatible gateway.
# COACH_DEEPSEEK_API_BASE=https://api.deepseek.com

# Default ``deepseek-v4-flash`` is DeepSeek-V4 non-thinking (successor
# to the retired ``deepseek-chat``, deprecated 2026-07-24; same price).
# See .env.example for cost/latency guidance.  ``deepseek-v4-pro``
# (thinking) costs more for similar quality on chess prose; not
# recommended.
# COACH_DEEPSEEK_MODEL=deepseek-v4-flash

# ── Optional overrides ───────────────────────────────────────────────────────
# STOCKFISH_PATH=/usr/games/stockfish
# UVICORN_WORKERS=2

# ── Billing — Google Play purchase verification ──────────────────────────────
# Powers POST /billing/google/verify (llm/seca/billing/router.py), which
# verifies a Play purchase token server-side and flips the player to Pro.
# Leave these UNSET pre-launch: with any one missing the endpoint answers
# 503 "purchase verification not configured" — safe and loud, never
# fake-success.  To go live, create a Play Console service account with
# the Android Publisher + financial-data grant, enable the Android
# Publisher API, download its JSON key, and set all three.  The package
# MUST match the shipped applicationId (com.cereveon.myapp).  The private
# key keeps the literal \n escapes from the JSON key file — the server
# normalises them.  Full runbook: docs/BILLING_GO_LIVE.md.
# GOOGLE_PLAY_PACKAGE_NAME=com.cereveon.myapp
# GOOGLE_PLAY_SA_EMAIL=CHANGE_ME@CHANGE_ME.iam.gserviceaccount.com
# GOOGLE_PLAY_SA_PRIVATE_KEY=CHANGE_ME

# ── Entitlements — freemium enforcement ──────────────────────────────────────
# Master switch for the free/Pro usage limits (llm/seca/entitlements).
# The paywall only has a PURPOSE when this is on, so production runs it
# ON.  Unset/empty/unrecognised = no metering (everyone effectively
# unlimited).  Recognised enable values: true / 1 / yes.  Limits live in
# llm/seca/entitlements/service.py::LIMITS.
SECA_ENTITLEMENTS_ENFORCED=true
