<?xml version="1.0" encoding="utf-8"?>
<!--
    Cereveon · Atrium · Settings (handoff screen #10).

    Sections divided by hairline rules:
      1.  Coach voice — radio (formal / conversational / terse).
      2.  Board style — radio (flat / engraved / wireframe).  Choice
          persists today; ChessBoardView consumes it once variant
          support lands (TODO marked in SettingsBottomSheet).
      3.  Appearance — radio (system / dark / bright).  System (the
          default) follows the phone's colour mode; Dark/Bright stay
          forced.  A changed selection applies immediately via
          AppCompatDelegate (SettingsBottomSheet dismisses first, then
          the hosts recreate into the selected palette).
      4.  Sound — switch.  Persists; no audio system to consume yet.
      5.  Notifications — switch.  Persists; no notifier to consume yet.
      6.  Account — chevron row that opens the existing change-password
          flow already wired in MainActivity drawer.

    Each row is 44dp tall with italic Cormorant title left, value or
    custom radio dot right.

    All view IDs are stable so SettingsBottomSheet.kt's findViewById
    resolves them.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_atrium_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/atrium_space_44">

        <!-- Drag handle. -->
        <View
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/atrium_space_8"
            android:layout_marginBottom="@dimen/atrium_space_8"
            android:background="@color/atrium_hairline_strong" />

        <!-- Chapter header. -->
        <com.cereveon.myapp.AtriumChapterHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:atriumKicker="Settings"
            app:atriumTitle="Preferences" />

        <!-- ── Coach voice ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Atrium.Kicker"
            android:text="Coach voice"
            android:paddingStart="@dimen/atrium_space_24"
            android:paddingEnd="@dimen/atrium_space_24"
            android:paddingTop="@dimen/atrium_space_16"
            android:paddingBottom="@dimen/atrium_space_8" />

        <LinearLayout
            android:id="@+id/voiceFormal"
            style="@style/Atrium.SettingsRow"
            android:tag="formal">

            <View
                android:id="@+id/voiceFormalDot"
                style="@style/Atrium.SettingsRow.Dot"
                android:background="@drawable/atrium_radio_unselected" />

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:text="Formal" />

            <TextView
                style="@style/Atrium.SettingsRow.Sub"
                android:text="Precise, restrained" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/voiceConversational"
            style="@style/Atrium.SettingsRow"
            android:tag="conversational">

            <View
                android:id="@+id/voiceConversationalDot"
                style="@style/Atrium.SettingsRow.Dot"
                android:background="@drawable/atrium_radio_selected" />

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:text="Conversational" />

            <TextView
                style="@style/Atrium.SettingsRow.Sub"
                android:text="Patient, scholarly" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/voiceTerse"
            style="@style/Atrium.SettingsRow"
            android:tag="terse">

            <View
                android:id="@+id/voiceTerseDot"
                style="@style/Atrium.SettingsRow.Dot"
                android:background="@drawable/atrium_radio_unselected" />

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:text="Terse" />

            <TextView
                style="@style/Atrium.SettingsRow.Sub"
                android:text="Brief, no flourish" />

        </LinearLayout>

        <View
            style="@style/Atrium.SettingsDivider" />

        <!-- ── Board style ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Atrium.Kicker"
            android:text="Board style"
            android:paddingStart="@dimen/atrium_space_24"
            android:paddingEnd="@dimen/atrium_space_24"
            android:paddingTop="@dimen/atrium_space_16"
            android:paddingBottom="@dimen/atrium_space_8" />

        <LinearLayout
            android:id="@+id/boardFlat"
            style="@style/Atrium.SettingsRow"
            android:tag="flat">

            <View
                android:id="@+id/boardFlatDot"
                style="@style/Atrium.SettingsRow.Dot"
                android:background="@drawable/atrium_radio_selected" />

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:text="Flat" />

            <TextView
                style="@style/Atrium.SettingsRow.Sub"
                android:text="Atrium default" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/boardEngraved"
            style="@style/Atrium.SettingsRow"
            android:tag="engraved">

            <View
                android:id="@+id/boardEngravedDot"
                style="@style/Atrium.SettingsRow.Dot"
                android:background="@drawable/atrium_radio_unselected" />

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:text="Engraved" />

            <TextView
                style="@style/Atrium.SettingsRow.Sub"
                android:text="Soft inset shadow" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/boardWireframe"
            style="@style/Atrium.SettingsRow"
            android:tag="wireframe">

            <View
                android:id="@+id/boardWireframeDot"
                style="@style/Atrium.SettingsRow.Dot"
                android:background="@drawable/atrium_radio_unselected" />

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:text="Wireframe" />

            <TextView
                style="@style/Atrium.SettingsRow.Sub"
                android:text="Cyan grid only" />

        </LinearLayout>

        <View
            style="@style/Atrium.SettingsDivider" />

        <!-- ── Appearance ───────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Atrium.Kicker"
            android:text="Appearance"
            android:paddingStart="@dimen/atrium_space_24"
            android:paddingEnd="@dimen/atrium_space_24"
            android:paddingTop="@dimen/atrium_space_16"
            android:paddingBottom="@dimen/atrium_space_8" />

        <LinearLayout
            android:id="@+id/rowAppearanceSystem"
            style="@style/Atrium.SettingsRow"
            android:tag="system">

            <View
                android:id="@+id/appearanceSystemDot"
                style="@style/Atrium.SettingsRow.Dot"
                android:background="@drawable/atrium_radio_selected" />

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:text="System" />

            <TextView
                style="@style/Atrium.SettingsRow.Sub"
                android:text="Match this phone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowAppearanceDark"
            style="@style/Atrium.SettingsRow"
            android:tag="dark">

            <View
                android:id="@+id/appearanceDarkDot"
                style="@style/Atrium.SettingsRow.Dot"
                android:background="@drawable/atrium_radio_unselected" />

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:text="Dark" />

            <TextView
                style="@style/Atrium.SettingsRow.Sub"
                android:text="Always dark" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowAppearanceBright"
            style="@style/Atrium.SettingsRow"
            android:tag="bright">

            <View
                android:id="@+id/appearanceBrightDot"
                style="@style/Atrium.SettingsRow.Dot"
                android:background="@drawable/atrium_radio_unselected" />

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:text="Bright" />

            <TextView
                style="@style/Atrium.SettingsRow.Sub"
                android:text="Always bright" />

        </LinearLayout>

        <View
            style="@style/Atrium.SettingsDivider" />

        <!-- ── Sound ────────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/rowSound"
            style="@style/Atrium.SettingsRow.Trailing">

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Sound" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/atrium_accent_cyan"
                android:trackTint="@color/atrium_hairline_strong" />

        </LinearLayout>

        <View
            style="@style/Atrium.SettingsDivider" />

        <!-- ── Notifications ────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/rowNotifications"
            style="@style/Atrium.SettingsRow.Trailing">

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Notifications" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/atrium_accent_cyan"
                android:trackTint="@color/atrium_hairline_strong" />

        </LinearLayout>

        <View
            style="@style/Atrium.SettingsDivider" />

        <!-- ── Profile ──────────────────────────────────────────────────
             The "Skill rating" row was the only entry under Profile
             and was retired when the user-visible Elo display was
             hidden from the UI.  Header + row + divider are kept in
             the tree with ``visibility="gone"`` so existing findViewById
             callers in SettingsBottomSheet.kt resolve without a
             refactor; the click handler is no longer wired. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Atrium.Kicker"
            android:text="Profile"
            android:paddingStart="@dimen/atrium_space_24"
            android:paddingEnd="@dimen/atrium_space_24"
            android:paddingTop="@dimen/atrium_space_16"
            android:paddingBottom="@dimen/atrium_space_8"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rowEditRating"
            style="@style/Atrium.SettingsRow.Trailing"
            android:visibility="gone">

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Skill rating" />

            <TextView
                android:id="@+id/rowEditRatingValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cormorant_garamond"
                android:textStyle="italic"
                android:textSize="17sp"
                android:textColor="@color/atrium_accent_cyan"
                android:layout_marginEnd="@dimen/atrium_space_12"
                android:text="—"
                tools:text="1720" />

            <TextView
                style="@style/Atrium.SettingsRow.Chevron"
                android:text="›" />

        </LinearLayout>

        <View
            style="@style/Atrium.SettingsDivider"
            android:visibility="gone" />

        <!-- ── Integrations ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Atrium.Kicker"
            android:text="Integrations"
            android:paddingStart="@dimen/atrium_space_24"
            android:paddingEnd="@dimen/atrium_space_24"
            android:paddingTop="@dimen/atrium_space_16"
            android:paddingBottom="@dimen/atrium_space_8" />

        <LinearLayout
            android:id="@+id/rowConnectLichess"
            style="@style/Atrium.SettingsRow.Trailing">

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Lichess" />

            <TextView
                android:id="@+id/rowConnectLichessValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:textStyle="italic"
                android:textSize="13sp"
                android:textColor="@color/atrium_muted"
                android:layout_marginEnd="@dimen/atrium_space_12"
                android:text="@string/lichess_settings_not_linked"
                tools:text="Linked · thibault" />

            <TextView
                style="@style/Atrium.SettingsRow.Chevron"
                android:text="›" />

        </LinearLayout>

        <View
            style="@style/Atrium.SettingsDivider" />

        <!-- ── Premium ──────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/rowUpgrade"
            style="@style/Atrium.SettingsRow.Trailing">

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textColor="@color/atrium_accent_cyan"
                android:text="Upgrade · Premium" />

            <TextView
                style="@style/Atrium.SettingsRow.Chevron"
                android:textColor="@color/atrium_accent_cyan"
                android:text="›" />

        </LinearLayout>

        <View
            style="@style/Atrium.SettingsDivider" />

        <!-- ── Account ──────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/rowChangePassword"
            style="@style/Atrium.SettingsRow.Trailing">

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Change password" />

            <TextView
                style="@style/Atrium.SettingsRow.Chevron"
                android:text="›" />

        </LinearLayout>

        <!-- GDPR Art. 15/20 self-serve export (GET /auth/me/export,
             contract §42): fetches the full account document and saves
             it wherever the user picks (Storage Access Framework — no
             permissions).  Non-destructive, so default row colours; the
             destructive rows below carry the amber accent. -->
        <LinearLayout
            android:id="@+id/rowDownloadData"
            style="@style/Atrium.SettingsRow.Trailing">

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Download my data" />

            <TextView
                style="@style/Atrium.SettingsRow.Chevron"
                android:text="›" />

        </LinearLayout>

        <!-- Opens the hosted Privacy Policy (GET /privacy) in the browser —
             the same page linked from the sign-up consent gate.  Passive /
             informational, so default row colours. -->
        <LinearLayout
            android:id="@+id/rowPrivacyPolicy"
            style="@style/Atrium.SettingsRow.Trailing">

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Privacy Policy" />

            <TextView
                style="@style/Atrium.SettingsRow.Chevron"
                android:text="›" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSignOut"
            style="@style/Atrium.SettingsRow.Trailing">

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textColor="@color/atrium_accent_amber"
                android:text="Sign out" />

            <TextView
                style="@style/Atrium.SettingsRow.Chevron"
                android:textColor="@color/atrium_accent_amber"
                android:text="›" />

        </LinearLayout>

        <!-- GDPR Art. 17 entry point (DELETE /auth/me, contract §41).
             The tap only opens AccountFlows' "Are you sure" dialog —
             SettingsDeleteAccountSourcePinTest pins that the row itself
             is never destructive.  Amber = the Atrium destructive
             accent (same as Sign out; the palette has no red token by
             design). -->
        <LinearLayout
            android:id="@+id/rowDeleteAccount"
            style="@style/Atrium.SettingsRow.Trailing">

            <TextView
                style="@style/Atrium.SettingsRow.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textColor="@color/atrium_accent_amber"
                android:text="Delete account" />

            <TextView
                style="@style/Atrium.SettingsRow.Chevron"
                android:textColor="@color/atrium_accent_amber"
                android:text="›" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
